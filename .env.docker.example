# ============================================================
# Docker MySQL 本地开发环境配置
# ============================================================
#
# 此文件为模板，不会被提交。复制为 .env 后使用：
#   copy .env.docker.example .env
#
# --- 启动 Docker MySQL ---
#   docker compose up -d
#
# --- 切换到 Docker 环境（三选一）---
#
# 方式 A（推荐，持久）：复制为 .env 并用 main.py 启动
#   copy .env.docker.example .env
#   $env:ENVIRONMENT="docker"
#   .\.venv\Scripts\python.exe main.py
#   # main.py 检测 ENVIRONMENT=docker 后加载 .env，DB_* 环境变量覆盖 .env.development
#
# 方式 B（临时，单次）：直接设置环境变量后用 uvicorn 启动
#   $env:DB_HOST="127.0.0.1"; $env:DB_PORT="3307"; $env:DB_NAME="omms_app"
#   $env:DB_USER="omms"; $env:DB_PASSWORD="omms_dev"
#   .\.venv\Scripts\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8004
#   # pydantic-settings 中环境变量优先级高于 .env.development 文件
#
# --- 切回开发环境 ---
#   del .env                    # 删除 .env（如有）
#   $env:ENVIRONMENT="development"
#   .\.venv\Scripts\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8004
#
# --- 重新初始化数据 ---
#   docker compose down -v      # 删除数据卷
#   docker compose up -d        # 重新执行 init 脚本
#
# 注意：
# - .env 已在 .gitignore 中，不会被提交。
# - Docker MySQL 外部端口 3307，避免与本地 MySQL 3306 冲突。
# - 初始化脚本仅在数据卷为空时执行（首次启动）。
# ============================================================

ENVIRONMENT=docker
HOST=0.0.0.0
PORT=8004

# Docker MySQL 连接（容器外部映射端口 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=omms_app
DB_USER=omms
DB_PASSWORD=omms_dev

# Ops monitor thresholds and pagination
OPS_OFFLINE_TIMEOUT_MINUTES=3
OPS_CPU_ALARM_THRESHOLD=1
OPS_MEM_ALARM_THRESHOLD=0.9
OPS_DISK_ALARM_THRESHOLD=0.9
OPS_DEFAULT_PAGE_NO=1
OPS_DEFAULT_PAGE_SIZE=10
OPS_MAX_PAGE_SIZE=100
